{
	"name": "fikifor",
	"author": "nazmirket",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:api": "pnpm --filter @fikifor/api dev",
		"dev:socket": "pnpm --filter @fikifor/api dev:socket",
		"dev:web": "pnpm --filter @fikifor/web dev",
		"build": "pnpm -r build",
		"lint": "pnpm -r lint && eslint scripts playwright.config.ts --max-warnings=0 && pnpm format:check",
		"format": "prettier --write \"{apps,packages}/**/*.{ts,vue,json}\" package.json pnpm-workspace.yaml eslint.config.mjs playwright.config.ts \".github/workflows/*.yml\" \"deploy/*.{yml,md}\" docker-compose.yml \"scripts/*.{mjs,json}\" AGENTS.md README.MD docs/harness.md",
		"format:check": "prettier --check \"{apps,packages}/**/*.{ts,vue,json}\" package.json pnpm-workspace.yaml eslint.config.mjs playwright.config.ts \".github/workflows/*.yml\" \"deploy/*.{yml,md}\" docker-compose.yml \"scripts/*.{mjs,json}\" AGENTS.md README.MD docs/harness.md",
		"test": "pnpm -r test",
		"test:e2e": "playwright test",
		"verify:isolated": "node scripts/verify-isolated.mjs",
		"typecheck": "pnpm -r typecheck",
		"db:build": "pnpm --filter @fikifor/api db:build",
		"db:migrate": "pnpm --filter @fikifor/api db:migrate",
		"db:deploy": "pnpm --filter @fikifor/api db:deploy",
		"podman:up": "podman compose up -d --build",
		"podman:down": "podman compose down",
		"podman:logs": "podman compose logs -f",
		"agents:check": "mirket project doctor --project . && node --test scripts/harness.node.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"typescript-eslint": "^8.71.2",
		"vue-eslint-parser": "^10.4.1"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@emnapi/core": "1",
				"@emnapi/runtime": "1",
				"@nuxt/schema": "3"
			}
		},
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"esbuild",
			"prisma",
			"sharp",
			"unrs-resolver"
		],
		"overrides": {
			"@vue/compiler-sfc": "3.5.44",
			"@vue/server-renderer": "3.5.44",
			"vue": "3.5.44",
			"axios": "1.20.0",
			"brace-expansion@1": "1.1.21",
			"brace-expansion@2": "2.1.7",
			"brace-expansion@5": "5.0.12",
			"devalue": "5.9.3",
			"deepmerge-ts": "8.0.2",
			"engine.io": "6.6.11",
			"ip-address": "10.7.4",
			"lodash": "4.18.0",
			"nanoid": "3.3.20",
			"seroval": "1.6.3",
			"proxy-addr": "2.0.8",
			"qs": "6.16.1",
			"shell-quote": "1.11.0",
			"source-map-js": "1.2.2",
			"svgo": "4.1.0",
			"vitest": "4.1.11"
		}
	}
}
