{
	"name": "@fikifor/api",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"lint": "eslint . --max-warnings=0",
		"prebuild": "pnpm db:build",
		"build": "rimraf ./build && tsc --project tsconfig.build.json",
		"typecheck": "tsc --noEmit --project tsconfig.json",
		"pretest": "pnpm --filter @fikifor/contracts build",
		"test": "vitest run",
		"test:watch": "vitest",
		"start": "node build/server.js",
		"start:socket": "node build/ws/server.js",
		"db:build": "ts-node prisma/build.ts",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"dev": "tsx watch server.ts",
		"dev:socket": "tsx watch ws/server.ts"
	},
	"author": "nazmirket",
	"devDependencies": {
		"@tsconfig/node20": "^20.1.4",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/lodash": "^4.17.11",
		"@types/multer": "^2.0.0",
		"@types/node": "^20.19.17",
		"@types/pg": "^8.11.11",
		"@types/supertest": "^7.2.1",
		"prettier": "^3.3.3",
		"prettier-plugin-prisma": "^5.0.0",
		"prisma": "^6.19.0",
		"rimraf": "^6.0.1",
		"supertest": "^7.1.4",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fikifor/contracts": "workspace:*",
		"@prisma/client": "^6.19.0",
		"@socket.io/redis-adapter": "^8.3.0",
		"bcryptjs": "^3.0.2",
		"cors": "^2.8.5",
		"dotenv": "^16.6.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.1.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.2",
		"pg": "^8.13.1",
		"pino": "^10.1.0",
		"pino-http": "^11.0.0",
		"redis": "^6.1.0",
		"sharp": "^0.35.3",
		"socket.io": "^4.8.1",
		"socket.io-client": "^4.8.1",
		"undici": "^7.16.0",
		"zod": "^4.3.6"
	},
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=10.0.0"
	}
}
