COMPOSE_PROJECT_NAME=fikifor-production

# Build and publish immutable versions for production deployments.
FIKIFOR_API_IMAGE=fikifor-api:latest
FIKIFOR_WEB_IMAGE=fikifor-web:latest
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

DB_USER=fikifor
DB_PASSWORD=replace-with-a-long-url-safe-database-password
DB_NAME=fikifor
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=12h
CORS_ORIGINS=https://quiz.example.com
TRUST_PROXY=1
LOG_LEVEL=info
REMOTE_IMAGE_MAX_BYTES=5000000
REMOTE_IMAGE_TIMEOUT_MS=8000
GAME_COUNTDOWN_MS=5000
MATCH_DEADLINE_MS=60000
SHUTDOWN_TIMEOUT_MS=10000

# Browser-visible origins. These are commonly routed through one TLS hostname.
PUBLIC_APP_URL=https://quiz.example.com
PUBLIC_API_URL=https://quiz.example.com/api/v1
PUBLIC_SOCKET_URL=https://quiz.example.com

# Bind to loopback and place a TLS reverse proxy in front of these ports.
BIND_WEB_PORT=3000
BIND_API_PORT=3001
BIND_SOCKET_PORT=3002

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
